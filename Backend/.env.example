# 🔐 ENVIRONMENT VARIABLES
# These are SECRET values that should NEVER be shared or committed to Git

# Port number where the backend server will run
PORT=5000

# MongoDB connection string
# Format: mongodb://localhost:27017/database-name
# For local MongoDB: mongodb://localhost:27017/leafy
# For MongoDB Atlas (cloud): mongodb+srv://username:password@cluster.mongodb.net/leafy
MONGODB_URI=mongodb://localhost:27017/leafy

# JWT Secret - This is used to sign authentication tokens
# Generate a random, strong secret: you can use any long random string
# Example: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production

# JWT Token Expiry (how long the token stays valid)
JWT_EXPIRE=7d

# Frontend URL (for CORS - Cross-Origin Resource Sharing)
# This allows your frontend to make requests to this backend
CLIENT_URL=http://localhost:5174

# Node Environment (development or production)
NODE_ENV=development
